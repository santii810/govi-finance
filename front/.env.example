# NocoDB — URL interna en Docker (http://nocodb:8080) o http://localhost:23456 en dev local
NOCODB_URL=http://nocodb:8080

# Token de API de NocoDB (Account Settings → API Tokens, o generado para la base Gastos)
NOCODB_API_TOKEN=

# Secreto para cookies de sesión (mínimo 32 caracteres aleatorios)
SESSION_SECRET=

# true solo si accedes por HTTPS; en http://localhost o IP local dejar sin definir o false
# COOKIE_SECURE=false

# Zona horaria para cálculos de mes (ver infra/.env TIMEZONE)
TIMEZONE=Europe/Madrid
