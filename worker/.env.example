# Copiar a infra/.env (no commitear)

# Token del bot (@BotFather)
TELEGRAM_BOT_TOKEN=

# IDs de Telegram permitidos (separados por coma). Vacío = todos (solo dev).
# Obtén tu ID con @userinfobot
TELEGRAM_ALLOWED_USER_IDS=

# Ya usados por web/nocodb
NOCODB_API_TOKEN=
SESSION_SECRET=
TIMEZONE=Europe/Madrid

# Opcional — defaults correctos en Docker
# NOCODB_URL=http://nocodb:8080
# AUTOMATIC_ACTIONS_TABLE_ID=mugm6tw1ail68rq
