# Backup manager — variables de entorno (añadir a infra/.env)

# none | google_drive | onedrive
BACKUP_PROVIDER=none

# Cron estándar (por defecto: 03:00 cada día)
BACKUP_SCHEDULE=0 3 * * *
BACKUP_TIMEZONE=Europe/Madrid

# Copias locales en volumen Docker (días)
BACKUP_LOCAL_RETENTION=7

# Base NocoDB a exportar (Gastos)
NOCODB_BASE_ID=pnf173not1wvzg0

# --- Google Drive (BACKUP_PROVIDER=google_drive) ---
# GOOGLE_DRIVE_CLIENT_ID=
# GOOGLE_DRIVE_CLIENT_SECRET=
# GOOGLE_DRIVE_REFRESH_TOKEN=
# GOOGLE_DRIVE_FOLDER_ID=

# --- OneDrive (BACKUP_PROVIDER=onedrive) ---
# ONEDRIVE_CLIENT_ID=
# ONEDRIVE_CLIENT_SECRET=
# ONEDRIVE_REFRESH_TOKEN=
# ONEDRIVE_FOLDER_PATH=/Finanzas/backups

# Trigger HTTP para backup manual (web)
BACKUP_TRIGGER_SECRET=
BACKUP_TRIGGER_PORT=8090
